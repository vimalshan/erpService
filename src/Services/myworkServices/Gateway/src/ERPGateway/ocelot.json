{
  // ─────────────────────────────────────────────────────────────────────────────
  //  ocelot.json  –  Reference configuration for Ocelot API Gateway
  //
  //  This file documents how the same routing/resilience rules would be expressed
  //  using Ocelot (https://ocelot.readthedocs.io).
  //
  //  The running gateway uses YARP (configured via appsettings.json → ReverseProxy).
  //  To switch to Ocelot instead:
  //    1. Add PackageReference "Ocelot" to ERPGateway.csproj
  //    2. In Program.cs call  builder.Configuration.AddJsonFile("ocelot.json")
  //                      and  app.UseOcelot().GetAwaiter().GetResult()
  //    3. Remove app.MapReverseProxy() and the YARP DI registration
  // ─────────────────────────────────────────────────────────────────────────────

  "Routes": [

    // ── Audit Service  (port 5037) ─────────────────────────────────────────────
    {
      "UpstreamPathTemplate":     "/audit/{everything}",
      "UpstreamHttpMethod":       [ "GET", "POST", "PUT", "DELETE", "PATCH" ],
      "DownstreamPathTemplate":   "/{everything}",
      "DownstreamScheme":         "http",
      "DownstreamHostAndPorts":   [ { "Host": "localhost", "Port": 5037 } ],
      "Key": "audit",
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "RateLimitOptions": {
        "ClientWhitelist":    [],
        "EnableRateLimiting": true,
        "Period":             "1m",
        "PeriodTimespan":     1,
        "Limit":              100
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 5,
        "DurationOfBreak":                 30000,
        "TimeoutValue":                    30000
      },
      "FileCacheOptions":    { "TtlSeconds": 30, "Region": "audit" },
      "AddHeadersToRequest": { "X-Forwarded-For": "{RemoteIpAddress}" },
      "LoadBalancerOptions": { "Type": "RoundRobin" }
    },

