{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "SigningKeys": [
      "AuditService-SuperSecret-Key-2026-ERP-Microservice-Min32Chars",
      "BatchService_SuperSecret_JWT_Key_2026_Min32Chars!",
      "CSA-Service-Super-Secret-Key-Min-32-Chars!!",
      "YourSuperSecretKeyForJWT_MinLength32Chars!!",
      "RiskService-SuperSecret-JWT-Key-Min32Chars!!",
      "TeamServicesDefaultSecretKey_ChangeInProduction_32chars!",
      "YourSuperSecretKeyThatIsAtLeast32CharactersLong!@#$"
    ]
  },

  "DownstreamServices": {
    "AuditService":     "http://audit-service",
    "BatchService":     "http://batch-service",
    "CsaService":       "http://csa-service",
    "ProjectService":   "http://project-service",
    "RiskService":      "http://risk-service",
    "TeamService":      "http://team-service",
    "TimeSheetService": "http://timesheet-service",
    "WorkOrderService": "http://workorder-service"
  },

  "ReverseProxy": {
    "Clusters": {
      "audit-cluster":     { "Destinations": { "audit-primary":     { "Address": "http://audit-service/" } } },
      "batch-cluster":     { "Destinations": { "batch-primary":     { "Address": "http://batch-service/" } } },
      "csa-cluster":       { "Destinations": { "csa-primary":       { "Address": "http://csa-service/" } } },
      "project-cluster":   { "Destinations": { "project-primary":   { "Address": "http://project-service/" } } },
      "risk-cluster":      { "Destinations": { "risk-primary":      { "Address": "http://risk-service/" } } },
      "team-cluster":      { "Destinations": { "team-primary":      { "Address": "http://team-service/" } } },
      "timesheet-cluster": { "Destinations": { "timesheet-primary": { "Address": "http://timesheet-service/" } } },
      "workorder-cluster": { "Destinations": { "workorder-primary": { "Address": "http://workorder-service/" } } }
    }
  }
}
