# ─── SQL Server ────────────────────────────────────────────────────────────────
DB_SA_PASSWORD=YourStrong@Passw0rd

# ─── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── Azure Blob Storage (optional – leave blank to skip blob features) ─────────
AZURE_BLOB_CONNECTION_STRING=

# ─── Container registry (used by build-push.ps1) ───────────────────────────────
REGISTRY=myregistry.azurecr.io
IMAGE_TAG=latest
