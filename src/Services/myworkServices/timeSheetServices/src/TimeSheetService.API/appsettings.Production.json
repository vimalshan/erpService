{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=MYWORKDB;User Id=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=TimeSheetService;Command Timeout=30"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!@#$",
    "Issuer": "TimeSheetService",
    "Audience": "TimeSheetServiceClients",
    "ExpirationInMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "timesheet-attachments"
  },
  "Polly": {
    "RetryCount": 3,
    "CircuitBreakerExceptionsAllowedBeforeBreaking": 5,
    "CircuitBreakerDurationOfBreakInSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
