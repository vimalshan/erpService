{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=MYWORKDB;User Id=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=TeamServices;Command Timeout=30"
  },
  "Jwt": {
    "Key": "TeamServicesDefaultSecretKey_ChangeInProduction_32chars!",
    "Issuer": "TeamServices",
    "Audience": "TeamServicesClient",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "team-images"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
