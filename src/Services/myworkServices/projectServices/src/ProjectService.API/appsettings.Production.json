{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=MYWORKDB;User Id=sa;Password=${DB_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=ProjectService;Command Timeout=30",
    "AzureBlobStorage": ""
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyForJWT_MinLength32Chars!!",
    "Issuer": "ProjectService.API",
    "Audience": "ProjectService.Clients",
    "ExpiryInMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/project-service-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
