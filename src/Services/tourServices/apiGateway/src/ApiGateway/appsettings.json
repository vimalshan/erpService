{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpiresInMinutes": 60
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 10
    },
    "Sliding": {
      "PermitLimit": 200,
      "Window": 60,
      "SegmentsPerWindow": 6,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 10
    },
    "Concurrency": {
      "PermitLimit": 50,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 25
    }
  },
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/yarp/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/admin"
          },
          {
            "PathPrefix": "/api/admin"
          }
        ],
        "Metadata": {
          "ServiceName": "AdminService"
        }
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/yarp/booking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/booking"
          },
          {
            "PathPrefix": "/api/booking"
          }
        ],
        "Metadata": {
          "ServiceName": "BookingService"
        }
      },
      "config-route": {
        "ClusterId": "config-cluster",
        "Match": {
          "Path": "/yarp/config/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/config"
          },
          {
            "PathPrefix": "/api/config"
          }
        ],
        "Metadata": {
          "ServiceName": "ConfigService"
        }
      },
      "tourplan-route": {
        "ClusterId": "tourplan-cluster",
        "Match": {
          "Path": "/yarp/tourplan/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/tourplan"
          },
          {
            "PathPrefix": "/api/tourplan"
          }
        ],
        "Metadata": {
          "ServiceName": "TourPlanService"
        }
      },
      "tour-route": {
        "ClusterId": "tour-cluster",
        "Match": {
          "Path": "/yarp/tour/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/tour"
          },
          {
            "PathPrefix": "/api/tour"
          }
        ],
        "Metadata": {
          "ServiceName": "TourService"
        }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": {
          "Path": "/yarp/transaction/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/transaction"
          },
          {
            "PathPrefix": "/api/transaction"
          }
        ],
        "Metadata": {
          "ServiceName": "TransactionService"
        }
      },
      "travel-route": {
        "ClusterId": "travel-cluster",
        "Match": {
          "Path": "/yarp/travel/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/yarp/travel"
          },
          {
            "PathPrefix": "/api/travel"
          }
        ],
        "Metadata": {
          "ServiceName": "TravelService"
        }
      }
    },
    "Clusters": {
      "admin-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "admin-primary": {
            "Address": "https://localhost:7288"
          }
        }
      },
      "booking-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "booking-primary": {
            "Address": "https://localhost:7063"
          }
        }
      },
      "config-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "config-primary": {
            "Address": "https://localhost:7216"
          }
        }
      },
      "tourplan-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "tourplan-primary": {
            "Address": "https://localhost:7185"
          }
        }
      },
      "tour-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "tour-primary": {
            "Address": "https://localhost:7041"
          }
        }
      },
      "transaction-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "transaction-primary": {
            "Address": "https://localhost:7045"
          }
        }
      },
      "travel-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "travel-primary": {
            "Address": "https://localhost:7019"
          }
        }
      }
    }
  },
  "HealthCheckEndpoints": {
    "AdminService": "https://localhost:7288/health",
    "BookingService": "https://localhost:7063/health",
    "ConfigService": "https://localhost:7216/health",
    "TourPlanService": "https://localhost:7185/health",
    "TourService": "https://localhost:7041/health",
    "TransactionService": "https://localhost:7045/health",
    "TravelService": "https://localhost:7019/health"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Ocelot": "Information",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}