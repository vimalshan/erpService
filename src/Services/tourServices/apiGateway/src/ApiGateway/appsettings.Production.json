{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "TourERP-Shared-Super-Secret-JWT-Key-2026-Production!",
    "Issuer": "TourERP.Gateway",
    "Audience": "TourERP.Clients",
    "ExpiresInMinutes": 60
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 500,
      "Window": 60,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 50
    },
    "Sliding": {
      "PermitLimit": 1000,
      "Window": 60,
      "SegmentsPerWindow": 6,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 50
    },
    "Concurrency": {
      "PermitLimit": 200,
      "QueueProcessingOrder": "OldestFirst",
      "QueueLimit": 100
    }
  },
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/yarp/admin/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/admin" },
          { "PathPrefix": "/api/admin" }
        ]
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/yarp/booking/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/booking" },
          { "PathPrefix": "/api/booking" }
        ]
      },
      "config-route": {
        "ClusterId": "config-cluster",
        "Match": { "Path": "/yarp/config/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/config" },
          { "PathPrefix": "/api/config" }
        ]
      },
      "tourplan-route": {
        "ClusterId": "tourplan-cluster",
        "Match": { "Path": "/yarp/tourplan/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/tourplan" },
          { "PathPrefix": "/api/tourplan" }
        ]
      },
      "tour-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/yarp/tour/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/tour" },
          { "PathPrefix": "/api/tour" }
        ]
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/yarp/transaction/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/transaction" },
          { "PathPrefix": "/api/transaction" }
        ]
      },
      "travel-route": {
        "ClusterId": "travel-cluster",
        "Match": { "Path": "/yarp/travel/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/travel" },
          { "PathPrefix": "/api/travel" }
        ]
      }
    },
    "Clusters": {
      "admin-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "admin-primary": { "Address": "http://admin-service:8080" } }
      },
      "booking-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "booking-primary": { "Address": "http://booking-service:8080" } }
      },
      "config-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "config-primary": { "Address": "http://config-service:8080" } }
      },
      "tourplan-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "tourplan-primary": { "Address": "http://tourplan-service:8080" } }
      },
      "tour-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "tour-primary": { "Address": "http://tour-service:8080" } }
      },
      "transaction-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "transaction-primary": { "Address": "http://transaction-service:8080" } }
      },
      "travel-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "travel-primary": { "Address": "http://travel-service:8080" } }
      }
    }
  },
  "HealthCheckEndpoints": {
    "AdminService": "http://admin-service:8080/health",
    "BookingService": "http://booking-service:8080/health",
    "ConfigService": "http://config-service:8080/health",
    "TourPlanService": "http://tourplan-service:8080/health",
    "TourService": "http://tour-service:8080/health",
    "TransactionService": "http://transaction-service:8080/health",
    "TravelService": "http://travel-service:8080/health"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "Logs/gateway-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
