    },
    {
      "name": "config-events-dlq",
      "vhost": "tour_vhost",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "tourplan-events-dlq",
      "vhost": "tour_vhost",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
