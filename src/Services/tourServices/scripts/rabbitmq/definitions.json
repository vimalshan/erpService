{
  "rabbit_version": "3.13",
  "users": [
    {
      "name": "tour_user",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "tour_vhost"
    }
  ],
  "permissions": [
    {
      "user": "tour_user",
      "vhost": "tour_vhost",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "tour-erp-exchange",
      "vhost": "tour_vhost",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "tour-erp-fanout",
      "vhost": "tour_vhost",
      "type": "fanout",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "tour-erp-dlx",
      "vhost": "tour_vhost",
      "type": "direct",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "tourplan_exchange",
      "vhost": "tour_vhost",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    {
      "name": "admin-events",
      "vhost": "tour_vhost",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "tour-erp-dlx",
        "x-dead-letter-routing-key": "admin-events-dlq",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "booking-events",
      "vhost": "tour_vhost",
      "durable": true,
      "auto_delete": false,
