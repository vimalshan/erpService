      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "tour-erp-dlx",
        "x-dead-letter-routing-key": "config-events-dlq",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "tourplan-events",
      "vhost": "tour_vhost",
      "durable": true,
      "auto_delete": false,
