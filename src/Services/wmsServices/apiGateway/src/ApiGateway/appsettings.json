{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Jwt": {
    "Key": "WMSApiGatewaySuperSecretKey2024AtLeast32Characters!!",
    "Issuer": "WMSApiGateway",
    "Audience": "WMSApiGatewayClients",
    "ExpiryInMinutes": 120
  },
  "RateLimiting": {
    "EnableGlobalRateLimiting": true,
    "GlobalRateLimit": {
      "PermitLimit": 500,
      "Window": 60,
      "QueueLimit": 10
    },
    "PerClientRateLimit": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueLimit": 5
    }
  },
  "CircuitBreaker": {
    "ExceptionsAllowedBeforeBreaking": 3,
    "DurationOfBreakInSeconds": 30
  },
  "Retry": {
    "MaxRetryAttempts": 3,
    "DelayInMilliseconds": 500
  },
  "Timeout": {
    "DefaultTimeoutInSeconds": 30
  },
  "Bulkhead": {
    "MaxParallelization": 50,
    "MaxQueuingActions": 25
  },
  "ReverseProxy": {
    "Routes": {
      "security-route": {
        "ClusterId": "security-cluster",
        "Match": { "Path": "/yarp/security/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/security" }
        ]
      },
      "warehouse-route": {
        "ClusterId": "warehouse-cluster",
        "Match": { "Path": "/yarp/warehouse/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/yarp/warehouse" }
        ]
      },
