{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Jwt": {
    "Key": "REPLACE_IN_ENV",
    "Issuer": "WMSApiGateway",
    "Audience": "WMSApiGatewayClients",
    "ExpiryInMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "security-route": {
        "ClusterId": "security-cluster",
        "Match": { "Path": "/yarp/security/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/security" }]
      },
      "warehouse-route": {
        "ClusterId": "warehouse-cluster",
        "Match": { "Path": "/yarp/warehouse/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/warehouse" }]
      },
      "racking-route": {
        "ClusterId": "racking-cluster",
        "Match": { "Path": "/yarp/racking/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/racking" }]
      },
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": { "Path": "/yarp/employee/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/employee" }]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/yarp/product/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/product" }]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/yarp/inventory/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/inventory" }]
      },
      "supplier-route": {
        "ClusterId": "supplier-cluster",
        "Match": { "Path": "/yarp/supplier/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/supplier" }]
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/yarp/customer/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/customer" }]
      },
      "purchaseorder-route": {
        "ClusterId": "purchaseorder-cluster",
        "Match": { "Path": "/yarp/purchaseorder/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/purchaseorder" }]
      },
      "receiving-route": {
        "ClusterId": "receiving-cluster",
        "Match": { "Path": "/yarp/receiving/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/receiving" }]
      },
      "salesorder-route": {
        "ClusterId": "salesorder-cluster",
        "Match": { "Path": "/yarp/salesorder/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/salesorder" }]
      },
      "shipment-route": {
        "ClusterId": "shipment-cluster",
        "Match": { "Path": "/yarp/shipment/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/shipment" }]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/yarp/order/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/order" }]
      },
      "fleet-route": {
        "ClusterId": "fleet-cluster",
        "Match": { "Path": "/yarp/fleet/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/fleet" }]
      },
      "auditlog-route": {
        "ClusterId": "auditlog-cluster",
        "Match": { "Path": "/yarp/auditlog/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/auditlog" }]
      },
      "transactional-route": {
        "ClusterId": "transactional-cluster",
        "Match": { "Path": "/yarp/transactional/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/transactional" }]
      }
    },
    "Clusters": {
      "security-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://security-service:8080/" } }
      },
      "warehouse-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://warehouse-service:8080/" } }
      },
      "racking-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://racking-service:8080/" } }
      },
      "employee-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://employee-service:8080/" } }
      },
      "product-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://product-service:8080/" } }
      },
      "inventory-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://inventory-service:8080/" } }
      },
      "supplier-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://supplier-service:8080/" } }
      },
      "customer-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://customer-service:8080/" } }
      },
      "purchaseorder-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://purchaseorder-service:8080/" } }
      },
      "receiving-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://receiving-service:8080/" } }
      },
      "salesorder-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://salesorder-service:8080/" } }
      },
      "shipment-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://shipment-service:8080/" } }
      },
      "order-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://order-service:8080/" } }
      },
      "fleet-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://fleet-service:8080/" } }
      },
      "auditlog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://auditlog-service:8080/" } }
      },
      "transactional-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://transactional-service:8080/" } }
      }
    }
  },
  "ServiceHealthChecks": {
    "SecurityService": "http://security-service:8080/health",
    "WarehouseStructureService": "http://warehouse-service:8080/health",
    "RackingSystemService": "http://racking-service:8080/health",
    "EmployeeService": "http://employee-service:8080/health",
    "ProductService": "http://product-service:8080/health",
    "InventoryService": "http://inventory-service:8080/health",
    "SupplierService": "http://supplier-service:8080/health",
    "CustomerService": "http://customer-service:8080/health",
    "PurchaseOrderService": "http://purchaseorder-service:8080/health",
    "ReceivingService": "http://receiving-service:8080/health",
    "SalesOrderService": "http://salesorder-service:8080/health",
    "ShipmentService": "http://shipment-service:8080/health",
    "OrderService": "http://order-service:8080/health",
    "FleetManagementService": "http://fleet-service:8080/health",
    "AuditLogService": "http://auditlog-service:8080/health",
    "WMTransactionalService": "http://transactional-service:8080/health"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Ocelot": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
