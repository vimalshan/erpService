{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=ProblemManagementDb;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Command Timeout=30",
    "AzureBlobStorage": "${AZURE_BLOB_CONNECTION}"
  },
  "Features": {
    "EnableRabbitMq": true
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "ProblemManagement.API",
    "Audience": "ProblemManagement.Client",
    "ExpirationInHours": 2
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "Port": 5672
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
