{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=SPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Command Timeout=30"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET_KEY}",
    "Issuer": "EmployeePrideManagement.API",
    "Audience": "EmployeePrideManagement.Client",
    "ExpirationInMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "AzureBlobStorage": {
    "ConnectionString": "${AZURE_BLOB_CONNECTION}",
    "ContainerName": "pride-images"
  },
  "Polly": {
    "RetryCount": 3,
    "BreakDuration": 30,
    "HandledEventsAllowedBeforeBreaking": 5
  }
}
