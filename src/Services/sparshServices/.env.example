# Sparsh Microservices Environment Configuration
# Copy to .env and update values for your environment

# SQL Server
SQL_SA_PASSWORD=Sparsh@2026!Secure

# RabbitMQ
RABBITMQ_USER=sparsh_user
RABBITMQ_PASSWORD=Sparsh@RMQ2026

# JWT (shared across all services for gateway token validation)
JWT_SECRET_KEY=SparshApiGateway_SuperSecret_Key_2026_Minimum32Chars!!

# Azure Blob Storage (override per service if needed)
AZURE_BLOB_CONNECTION=UseDevelopmentStorage=true

# Docker Registry (for pushing images)
DOCKER_REGISTRY=sparsh.azurecr.io
IMAGE_TAG=latest
