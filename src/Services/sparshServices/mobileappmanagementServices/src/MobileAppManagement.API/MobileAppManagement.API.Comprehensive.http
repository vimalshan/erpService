@baseUrl = http://localhost:5154
@authToken = 
@employeeSysId = 1001
@userId = USR001
@userSysId = 1
@deviceId = DEVICE001
@imeiNo = 123456789012345
@deviceType = MOBILE
@registrationId = 1
@loginId = 1

### ============================================
### 1. AUTHENTICATION ENDPOINTS
### ============================================

### 1.1 POST - Generate JWT Token (No Auth Required)
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "username": "testuser",
  "password": "testpassword"
}

### ============================================
### 2. CONTROLLER ENDPOINTS (REST)
### ============================================

### 2.1 AuthController - POST /api/auth/token (Token Generation)
POST {{baseUrl}}/api/auth/token
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### 2.2 DevicesController - POST /api/devices/register (Register Device)
POST {{baseUrl}}/api/devices/register
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "employeeSysId": {{employeeSysId}},
  "deviceId": "{{deviceId}}",
  "deviceType": "{{deviceType}}",
  "imeiNo": "{{imeiNo}}",
  "updatedBy": "ADMIN"
}

### 2.3 DevicesController - GET /api/devices/employee/{employeeSysId} (Get Devices by Employee)
GET {{baseUrl}}/api/devices/employee/{{employeeSysId}}
Authorization: Bearer {{authToken}}

### 2.4 DevicesController - GET /api/devices/{employeeSysId}/{deviceId} (Get Device by Key)
GET {{baseUrl}}/api/devices/{{employeeSysId}}/{{deviceId}}
Authorization: Bearer {{authToken}}

### 2.5 DevicesController - POST /api/devices/deactivate (Deactivate Device)
POST {{baseUrl}}/api/devices/deactivate
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "employeeSysId": {{employeeSysId}},
  "deviceId": "{{deviceId}}",
  "updatedBy": "ADMIN"
}

### 2.6 LoginsController - POST /api/logins (Log User Login - No Auth Required)
POST {{baseUrl}}/api/logins
Content-Type: application/json

{
  "userSysId": {{userSysId}},
  "deviceId": "{{deviceId}}",
  "imeiNo": "{{imeiNo}}",
  "deviceType": "{{deviceType}}"
}

### 2.7 LoginsController - GET /api/logins/user/{userSysId} (Get Logins by User)
GET {{baseUrl}}/api/logins/user/{{userSysId}}
Authorization: Bearer {{authToken}}

### 2.8 LoginsController - GET /api/logins/{loginId} (Get Login by ID)
GET {{baseUrl}}/api/logins/{{loginId}}
Authorization: Bearer {{authToken}}

### 2.9 RegistrationsController - POST /api/registrations (Create Registration)
POST {{baseUrl}}/api/registrations
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "registrationId": 0,
  "employeeSysId": {{employeeSysId}},
  "userId": "{{userId}}",
  "userSysId": {{userSysId}},
  "userType": "EMPLOYEE",
  "mobileNo": "9876543210",
  "imeiNo": "{{imeiNo}}",
  "deviceId": "{{deviceId}}",
  "deviceType": "{{deviceType}}"
}

### 2.10 RegistrationsController - GET /api/registrations/{registrationId} (Get Registration by ID)
GET {{baseUrl}}/api/registrations/{{registrationId}}
Authorization: Bearer {{authToken}}

### 2.11 RegistrationsController - GET /api/registrations/user/{userId} (Get Registrations by User)
GET {{baseUrl}}/api/registrations/user/{{userId}}
Authorization: Bearer {{authToken}}

### 2.12 RegistrationsController - GET /api/registrations/status/{status} (Get Registrations by Status)
GET {{baseUrl}}/api/registrations/status/P
Authorization: Bearer {{authToken}}

### 2.13 RegistrationsController - PUT /api/registrations/{registrationId}/status (Update Registration Status)
PUT {{baseUrl}}/api/registrations/{{registrationId}}/status
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "newStatus": "A"
}

### 2.14 RegistrationsController - POST /api/registrations/{registrationId}/generate-pin (Generate PIN)
POST {{baseUrl}}/api/registrations/{{registrationId}}/generate-pin
Authorization: Bearer {{authToken}}

### 2.15 BlobStorageController - POST /api/blobstorage/upload (Upload Image)
POST {{baseUrl}}/api/blobstorage/upload
Authorization: Bearer {{authToken}}

< ./test-image.jpg

### 2.16 BlobStorageController - GET /api/blobstorage/{blobName} (Download Blob)
GET {{baseUrl}}/api/blobstorage/test-blob.jpg
Authorization: Bearer {{authToken}}

### 2.17 BlobStorageController - DELETE /api/blobstorage/{blobName} (Delete Blob)
DELETE {{baseUrl}}/api/blobstorage/test-blob.jpg
Authorization: Bearer {{authToken}}

