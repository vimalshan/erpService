{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=SPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Command Timeout=30"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "MobileAppManagement.API",
    "Audience": "MobileAppManagement.Client",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "Port": 5672
  },
  "AzureBlobStorage": {
    "ConnectionString": "${AZURE_BLOB_CONNECTION}",
    "ContainerName": "mobile-app-images"
  },
  "HealthChecks": {
    "SqlServer": {
      "Timeout": 5
    },
    "RabbitMQ": {
      "Timeout": 5
    }
  }
}
