## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio 2015 cache/options directory
.vs/
.vscode/

# Build results
bin/
obj/
*.dll
*.exe
*.pdb

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
.nuget/

# Local environment
local.settings.json
.env
.env.local

# Log files
logs/
*.log
