{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=ERPFinanceDB;User Id=sa;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True;Command Timeout=30"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ERPMicroservice",
    "Audience": "ERPMicroserviceClients",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Enabled": true,
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "erp",
    "Username": "erpadmin",
    "Password": "",
    "ExchangeName": "erp.events",
    "RetryCount": 5,
    "RetryIntervalSeconds": 5
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "finance-documents"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/finance-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Properties": {
      "Application": "ERP.FinanceService",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "*"
}
