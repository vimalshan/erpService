{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5140"
      },
      "Https": {
        "Url": "https://localhost:7000"
      }
    }
  },
  "Jwt": {
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpiryInMinutes": 60,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:8080"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 20
    },
    "PerUser": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 5
    }
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "MinimumThroughput": 10,
      "BreakDurationSeconds": 30
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelaySeconds": 1,
      "UseExponentialBackoff": true
    },
    "Timeout": {
      "TimeoutSeconds": 30
    },
    "Bulkhead": {
      "MaxParallelization": 100,
      "MaxQueuingActions": 50
    }
  },
  "ResponseCache": {
    "DefaultDurationSeconds": 60,
    "VaryByQueryKeys": [
      "*"
    ]
  },
  "HealthChecks": {
    "Services": [
      {
        "Name": "Action Service",
        "Uri": "http://localhost:5001/health"
      },
      {
        "Name": "Audit Service",
        "Uri": "http://localhost:5002/health"
      },
      {
        "Name": "Certificate Service",
        "Uri": "http://localhost:5003/health"
      },
      {
        "Name": "Contract Service",
        "Uri": "http://localhost:5004/health"
      },
      {
        "Name": "Finance Service",
        "Uri": "http://localhost:5005/health"
      },
      {
        "Name": "Findings Service",
        "Uri": "http://localhost:5195/health"
      },
      {
        "Name": "Notification Service",
        "Uri": "http://localhost:5007/health"
      },
      {
        "Name": "Schedule Service",
        "Uri": "http://localhost:5008/health"
      },
      {
        "Name": "Settings Service",
        "Uri": "http://localhost:5009/health"
      }
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "ERP.ApiGateway",
      "Environment": "Production"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "action-rest-route": {
        "ClusterId": "action-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/api/actions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/actions/{**catch-all}"
          },
          {
            "ResponseHeader": "X-Proxied-By",
            "Value": "ERP-Gateway",
            "Append": "always"
          }
        ]
      },
      "action-graphql-route": {
        "ClusterId": "action-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "global",
        "Match": {
          "Path": "/graphql/actions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/graphql/{**catch-all}"
          }
        ]
      },
