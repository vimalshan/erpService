{
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "RequestIdKey": "X-Correlation-Id",
    "RateLimitOptions": {
      "ClientIdHeader": "X-Client-Id",
      "DisableRateLimitHeaders": false,
      "HttpStatusCode": 429,
      "QuotaExceededMessage": "Rate limit exceeded. Please retry after {0} seconds.",
      "RateLimitCounterPrefix": "ocelot",
      "EnableRateLimiting": true
    }
  },
  "Routes": [
    {
      "RouteId": "action-rest",
      "UpstreamPathTemplate": "/api/actions/{everything}",
