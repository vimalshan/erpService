{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SRFSPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=UserManagementService;Command Timeout=30"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "UserManagement.API",
    "Audience": "UserManagement.Clients",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "srfsparsh",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/",
    "ExchangeName": "user_management"
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "${AZURE_BLOB_CONNECTION_STRING}",
      "ContainerName": "user-documents"
    }
  }
}
