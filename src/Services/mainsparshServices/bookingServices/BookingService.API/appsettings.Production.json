{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookingDb": "Server=sqlserver;Database=SRFSPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=BookingService;Command Timeout=30"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "BookingService",
    "Audience": "BookingServiceClients",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "srfsparsh",
    "Password": "${RABBITMQ_PASSWORD}",
    "ExchangeName": "booking.exchange"
  },
  "AzureStorage": {
    "ConnectionString": "${AZURE_BLOB_CONNECTION_STRING}"
  }
}
