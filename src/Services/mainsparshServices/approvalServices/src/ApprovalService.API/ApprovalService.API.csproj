<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ApprovalService.Application/ApprovalService.Application.csproj" />
    <ProjectReference Include="../ApprovalService.Infrastructure/ApprovalService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web API -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.3" />
    <!-- Swagger/OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.8" />
    <!-- GraphQL -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="13.6.0" />
    <PackageReference Include="HotChocolate.Types" Version="13.6.0" />
    <!-- JWT Authentication -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.3" />
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
    <!-- Correlation ID -->
    <PackageReference Include="CorrelationId" Version="3.0.1" />
  </ItemGroup>

</Project>
