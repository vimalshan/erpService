{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=ApprovalServiceDb;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=ApprovalService",
    "AzureBlobStorage": "${AZURE_BLOB_CONNECTION_STRING}",
    "RabbitMq": "amqp://srfsparsh:${RABBITMQ_PASSWORD}@rabbitmq:5672/"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "ApprovalService",
    "Audience": "ApprovalServiceUsers",
    "ExpirationHours": 24
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "srfsparsh",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/"
  },
  "HealthChecks": {
    "CheckInterval": 30
  }
}
