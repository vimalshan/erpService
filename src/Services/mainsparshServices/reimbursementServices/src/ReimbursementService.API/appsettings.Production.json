{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SRFSPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=ReimbursementService",
    "AzureBlobStorage": "${AZURE_BLOB_CONNECTION_STRING}"
  },
  "JwtSettings": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "ReimbursementService",
    "Audience": "ReimbursementServiceClients",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "srfsparsh",
    "Password": "${RABBITMQ_PASSWORD}",
    "UseInMemory": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
