{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Ocelot": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "SRFSparshMicroservices",
    "Audience": "SRFSparshClients",
    "ExpirationMinutes": 60
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{ \"message\": \"API rate limit exceeded. Please try again later.\" }",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 50 },
      { "Endpoint": "*", "Period": "1m", "Limit": 1000 },
      { "Endpoint": "*", "Period": "1h", "Limit": 25000 },
      { "Endpoint": "post:*/auth/*", "Period": "1m", "Limit": 20 }
    ]
  },
  "ServiceDiscovery": {
    "approval": "http://approval-service:80",
    "booking": "http://booking-service:80",
    "community": "http://community-service:80",
    "compensation": "http://compensation-service:80",
    "groupmanagement": "http://groupmanagement-service:80",
    "location": "http://location-service:80",
    "meeting": "http://meeting-service:80",
    "proxy": "http://proxy-service:80",
    "reimbursement": "http://reimbursement-service:80",
    "stipend": "http://stipend-service:80",
    "timesheet": "http://timesheet-service:80",
    "transaction": "http://transaction-service:80",
    "usermanagement": "http://usermanagement-service:80",
    "websitecontent": "http://websitecontent-service:80"
  },
  "ReverseProxy": {
    "Routes": {
      "approval-route": { "ClusterId": "approval-cluster", "Match": { "Path": "/api/approval/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/approval" }, { "PathPrefix": "/api" } ] },
      "approval-graphql": { "ClusterId": "approval-cluster", "Match": { "Path": "/graphql/approval/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/approval" }, { "PathPrefix": "/graphql" } ] },
      "booking-route": { "ClusterId": "booking-cluster", "Match": { "Path": "/api/booking/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/booking" }, { "PathPrefix": "/api" } ] },
      "booking-graphql": { "ClusterId": "booking-cluster", "Match": { "Path": "/graphql/booking/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/booking" }, { "PathPrefix": "/graphql" } ] },
      "community-route": { "ClusterId": "community-cluster", "Match": { "Path": "/api/community/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/community" }, { "PathPrefix": "/api" } ] },
      "community-graphql": { "ClusterId": "community-cluster", "Match": { "Path": "/graphql/community/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/community" }, { "PathPrefix": "/graphql" } ] },
      "compensation-route": { "ClusterId": "compensation-cluster", "Match": { "Path": "/api/compensation/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/compensation" }, { "PathPrefix": "/api" } ] },
      "compensation-graphql": { "ClusterId": "compensation-cluster", "Match": { "Path": "/graphql/compensation/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/compensation" }, { "PathPrefix": "/graphql" } ] },
      "groupmanagement-route": { "ClusterId": "groupmanagement-cluster", "Match": { "Path": "/api/groupmanagement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/groupmanagement" }, { "PathPrefix": "/api" } ] },
      "groupmanagement-graphql": { "ClusterId": "groupmanagement-cluster", "Match": { "Path": "/graphql/groupmanagement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/groupmanagement" }, { "PathPrefix": "/graphql" } ] },
      "location-route": { "ClusterId": "location-cluster", "Match": { "Path": "/api/location/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/location" }, { "PathPrefix": "/api" } ] },
      "location-graphql": { "ClusterId": "location-cluster", "Match": { "Path": "/graphql/location/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/location" }, { "PathPrefix": "/graphql" } ] },
      "meeting-route": { "ClusterId": "meeting-cluster", "Match": { "Path": "/api/meeting/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/meeting" }, { "PathPrefix": "/api" } ] },
      "meeting-graphql": { "ClusterId": "meeting-cluster", "Match": { "Path": "/graphql/meeting/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/meeting" }, { "PathPrefix": "/graphql" } ] },
      "proxy-route": { "ClusterId": "proxy-cluster", "Match": { "Path": "/api/proxy/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/proxy" }, { "PathPrefix": "/api" } ] },
      "proxy-graphql": { "ClusterId": "proxy-cluster", "Match": { "Path": "/graphql/proxy/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/proxy" }, { "PathPrefix": "/graphql" } ] },
      "reimbursement-route": { "ClusterId": "reimbursement-cluster", "Match": { "Path": "/api/reimbursement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/reimbursement" }, { "PathPrefix": "/api" } ] },
      "reimbursement-graphql": { "ClusterId": "reimbursement-cluster", "Match": { "Path": "/graphql/reimbursement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/reimbursement" }, { "PathPrefix": "/graphql" } ] },
      "stipend-route": { "ClusterId": "stipend-cluster", "Match": { "Path": "/api/stipend/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/stipend" }, { "PathPrefix": "/api" } ] },
      "stipend-graphql": { "ClusterId": "stipend-cluster", "Match": { "Path": "/graphql/stipend/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/stipend" }, { "PathPrefix": "/graphql" } ] },
      "timesheet-route": { "ClusterId": "timesheet-cluster", "Match": { "Path": "/api/timesheet/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/timesheet" }, { "PathPrefix": "/api" } ] },
      "timesheet-graphql": { "ClusterId": "timesheet-cluster", "Match": { "Path": "/graphql/timesheet/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/timesheet" }, { "PathPrefix": "/graphql" } ] },
      "transaction-route": { "ClusterId": "transaction-cluster", "Match": { "Path": "/api/transaction/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/transaction" }, { "PathPrefix": "/api" } ] },
      "transaction-graphql": { "ClusterId": "transaction-cluster", "Match": { "Path": "/graphql/transaction/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/transaction" }, { "PathPrefix": "/graphql" } ] },
      "usermanagement-route": { "ClusterId": "usermanagement-cluster", "Match": { "Path": "/api/usermanagement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/usermanagement" }, { "PathPrefix": "/api" } ] },
      "usermanagement-graphql": { "ClusterId": "usermanagement-cluster", "Match": { "Path": "/graphql/usermanagement/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/usermanagement" }, { "PathPrefix": "/graphql" } ] },
      "websitecontent-route": { "ClusterId": "websitecontent-cluster", "Match": { "Path": "/api/websitecontent/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/websitecontent" }, { "PathPrefix": "/api" } ] },
      "websitecontent-graphql": { "ClusterId": "websitecontent-cluster", "Match": { "Path": "/graphql/websitecontent/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/graphql/websitecontent" }, { "PathPrefix": "/graphql" } ] }
    },
    "Clusters": {
      "approval-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://approval-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "booking-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://booking-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "community-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://community-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "compensation-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://compensation-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "groupmanagement-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://groupmanagement-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "location-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://location-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "meeting-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://meeting-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "proxy-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://proxy-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "reimbursement-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://reimbursement-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "stipend-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://stipend-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "timesheet-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://timesheet-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "transaction-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://transaction-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "usermanagement-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://usermanagement-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } },
      "websitecontent-cluster": { "LoadBalancingPolicy": "RoundRobin", "Destinations": { "destination1": { "Address": "http://websitecontent-service:80" } }, "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } } }
    }
  }
}
