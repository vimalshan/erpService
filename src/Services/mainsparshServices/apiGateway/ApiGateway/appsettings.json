{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "JwtSettings": {
    "SecretKey": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpirationMinutes": 60
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 200
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 5000
      },
      {
        "Endpoint": "post:*/auth/*",
        "Period": "1m",
        "Limit": 10
      }
    ]
  },
  "ClientRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "ClientRules": [
      {
        "ClientId": "default",
        "Rules": [
          {
            "Endpoint": "*",
            "Period": "1s",
            "Limit": 20
          },
          {
            "Endpoint": "*",
            "Period": "1m",
            "Limit": 400
          }
        ]
      }
    ]
  },
  "CircuitBreaker": {
    "FailureThreshold": 0.5,
    "SamplingDurationSeconds": 30,
    "MinimumThroughput": 10,
    "BreakDurationSeconds": 15
  },
  "RetryPolicy": {
    "MaxRetries": 3,
    "BaseDelayMs": 200,
    "TimeoutSeconds": 30
  },
  "BulkheadPolicy": {
    "MaxParallelization": 50,
    "MaxQueuingActions": 25
  },
  "ResponseCaching": {
    "DefaultDurationSeconds": 30,
    "MaxBodySizeBytes": 67108864
  },
  "ServiceDiscovery": {
    "ApprovalService": "http://localhost:5000",
    "BookingService": "http://localhost:5127",
    "CommunityService": "http://localhost:5128",
    "CompensationService": "http://localhost:5129",
    "GroupManagementService": "http://localhost:5130",
    "LocationService": "http://localhost:5131",
    "MeetingService": "http://localhost:5225",
    "ProxyService": "http://localhost:5237",
    "ReimbursementService": "http://localhost:5202",
    "StipendService": "http://localhost:5152",
    "TimesheetService": "http://localhost:5272",
    "TransactionService": "http://localhost:5133",
    "UserManagementService": "http://localhost:5243",
    "WebsiteContentService": "http://localhost:5216"
  },
