        { "Host": "localhost", "Port": 5000 }
      ],
      "Key": "approval",
      "RateLimitOptions": { "ClientWhitelist": [], "EnableRateLimiting": true, "Period": "1m", "PeriodTimespan": 1, "Limit": 100 },
