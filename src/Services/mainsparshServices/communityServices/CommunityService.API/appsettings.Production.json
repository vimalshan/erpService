{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SRFSPARSHDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=CommunityService",
    "AzureBlobStorage": "${AZURE_BLOB_CONNECTION_STRING}"
  },
  "Jwt": {
    "Issuer": "CommunityService",
    "Audience": "CommunityServiceAPI",
    "SigningKey": "${JWT_SECRET_KEY}",
    "ExpirationMinutes": 60
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "UserName": "srfsparsh",
    "Password": "${RABBITMQ_PASSWORD}",
    "Port": 5672
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "${AZURE_BLOB_CONNECTION_STRING}",
      "ContainerName": "community-assets"
    }
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "FailureWindow": 10,
    "SuccessThreshold": 2,
    "SuccessWindow": 30,
    "TimeoutDuration": 5
  }
}
