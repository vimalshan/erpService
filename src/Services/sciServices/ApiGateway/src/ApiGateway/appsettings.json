{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Ocelot": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Ocelot": "Information",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrelationId:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Jwt": {
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpireMinutes": 60
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueLimit": 10
    },
    "Sliding": {
      "PermitLimit": 200,
      "Window": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    },
    "Token": {
      "TokenLimit": 500,
      "ReplenishmentPeriod": 10,
      "TokensPerPeriod": 50,
      "QueueLimit": 10
    }
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": 30,
      "MinimumThroughput": 10,
      "BreakDuration": 30
    },
    "Retry": {
      "MaxRetries": 3,
      "BaseDelay": 1,
      "BackoffType": "Exponential"
    },
    "Timeout": {
      "TimeoutSeconds": 30
    },
    "Bulkhead": {
      "MaxParallelization": 25,
      "MaxQueuingActions": 50
    }
  },
  "ReverseProxy": {
