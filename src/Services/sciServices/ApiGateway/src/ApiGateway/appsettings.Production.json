{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Ocelot": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Ocelot": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/gateway/gateway-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrelationId:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Key": "${JWT_SECRET}",
    "Issuer": "ERPMicroservice",
    "Audience": "ERPMicroservice",
    "ExpireMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "sci_vhost"
  },
  "RateLimiting": {
    "Fixed": { "PermitLimit": 500, "Window": 60, "QueueLimit": 50 },
    "Sliding": { "PermitLimit": 1000, "Window": 60, "SegmentsPerWindow": 6, "QueueLimit": 50 },
    "Token": { "TokenLimit": 2000, "ReplenishmentPeriod": 10, "TokensPerPeriod": 200, "QueueLimit": 50 }
  },
  "Resilience": {
    "CircuitBreaker": { "FailureRatio": 0.5, "SamplingDuration": 30, "MinimumThroughput": 20, "BreakDuration": 30 },
    "Retry": { "MaxRetries": 3, "BaseDelay": 1, "BackoffType": "Exponential" },
    "Timeout": { "TimeoutSeconds": 30 },
    "Bulkhead": { "MaxParallelization": 50, "MaxQueuingActions": 100 }
  },
  "ServiceUrls": {
    "SecurityService": "http://security-service:80",
    "VehicleTracking": "http://vehicle-tracking-service:80",
    "DispatchPlanning": "http://dispatch-planning-service:80",
    "OrderSchedule": "http://order-schedule-service:80",
    "FillingOperation": "http://filling-operation-service:80",
    "EximManagement": "http://exim-management-service:80",
    "GSTCompliance": "http://gst-compliance-service:80",
    "InventoryManagement": "http://inventory-management-service:80",
    "ProductionManagement": "http://production-management-service:80",
    "MamAllocation": "http://mam-allocation-service:80",
    "PurchaseSales": "http://purchase-sales-service:80",
    "MasterData": "http://master-data-service:80",
    "StrategicStock": "http://strategic-stock-service:80",
    "ErrorLogging": "http://error-logging-service:80",
    "SciTransactional": "http://sci-transactional-service:80"
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 500,
      "MaxRequestBodySize": 52428800,
      "RequestHeadersTimeout": "00:00:30"
    }
  }
}
