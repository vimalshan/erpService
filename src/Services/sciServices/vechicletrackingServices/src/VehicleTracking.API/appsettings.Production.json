{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=SCIDB;User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=true;Encrypt=true;MultipleActiveResultSets=true;Connection Timeout=30"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "ERPMicroservice",
    "Audience": "ERPMicroservice",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "sci_vhost",
    "RetryCount": 5,
    "RetryIntervalMs": 3000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 200,
      "MaxRequestBodySize": 52428800,
      "RequestHeadersTimeout": "00:00:30"
    }
  }
}
