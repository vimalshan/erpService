{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5600",
  "Jwt": {
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "SecretKey": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "ExpiryMinutes": 480
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 200
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 3000
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  },
  "Bulkhead": {
    "Services": {
      "accident": {
        "MaxConcurrency": 20
      },
      "checkup": {
        "MaxConcurrency": 20
      },
      "insurance": {
        "MaxConcurrency": 15
      },
      "masters": {
        "MaxConcurrency": 30
      },
      "medicalvisit": {
        "MaxConcurrency": 20
      },
      "medicine": {
        "MaxConcurrency": 20
      },
      "transaction": {
        "MaxConcurrency": 20
      }
    }
  },
  "Services": {
    "AccidentManagement": "http://localhost:5000",
    "CheckupManagement": "http://localhost:7101",
    "InsuranceManagement": "http://localhost:5100",
    "Masters": "http://localhost:5200",
    "MedicalVisit": "http://localhost:5300",
    "MedicineManagement": "http://localhost:5400",
    "HealthTransaction": "http://localhost:5500"
  }
}