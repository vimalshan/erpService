        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/accident" },
        "Transforms": [
          { "PathSet": "/graphql" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
        ]
      },
      "checkup-graphql-route": {
        "ClusterId": "checkup-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/checkup" },
        "Transforms": [
          { "PathSet": "/graphql" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
        ]
      },
      "insurance-graphql-route": {
        "ClusterId": "insurance-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/insurance" },
        "Transforms": [
          { "PathSet": "/graphql" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
