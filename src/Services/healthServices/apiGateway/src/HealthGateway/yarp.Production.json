{
  "ReverseProxy": {
    "Routes": {
      "accident-route": {
        "ClusterId": "accident-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/api/accident/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/accident" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
        ]
      },
      "checkup-route": {
        "ClusterId": "checkup-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/api/checkup/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/checkup" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
        ]
      },
