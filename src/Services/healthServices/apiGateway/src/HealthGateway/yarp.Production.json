          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
        ]
      },
      "medicine-graphql-route": {
        "ClusterId": "medicine-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/graphql/medicine" },
        "Transforms": [
          { "PathSet": "/graphql" },
          { "RequestHeader": "X-Gateway-Source", "Set": "HealthGateway" }
