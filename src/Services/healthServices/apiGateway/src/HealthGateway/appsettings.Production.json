{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:5600",
  "Jwt": {
    "Issuer": "HealthGateway",
    "Audience": "HealthServices",
    "SecretKey": "${JWT_SECRET_KEY}",
    "ExpiryMinutes": 480
  },
  "Services": {
    "AccidentManagement": "http://accident-service:5000",
    "CheckupManagement": "http://checkup-service:7101",
    "InsuranceManagement": "http://insurance-service:5100",
    "Masters": "http://masters-service:5200",
    "MedicalVisit": "http://medicalvisit-service:5300",
    "MedicineManagement": "http://medicine-service:5400",
    "HealthTransaction": "http://transaction-service:5500"
  }
}
