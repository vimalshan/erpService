{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HealthDb": "Server=.;Database=HEALTHDB;Trusted_Connection=true;Encrypt=false;"
  },
  "AppSettings": {
    "ServiceName": "CheckupManagementService",
    "ServicePort": 7138,
    "ApiVersion": "v1",
    "EnableSwagger": true
  },
  "JWT": {
    "SecretKey": "your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-HS256",
    "Issuer": "CheckupManagementService",
    "Audience": "CheckupManagementAPI",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "ClockSkew": 5
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "health_exchange",
    "QueueName": "checkup_queue",
    "RoutingKey": "checkup.*"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "CacheKeyPrefix": "health_checkup",
    "DefaultExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000"
    ]
  }
}
