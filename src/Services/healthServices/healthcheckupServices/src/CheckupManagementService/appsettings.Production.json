{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HealthDb": "Server=sqlserver;Database=HEALTHDB;User Id=sa;Password=Health@Erp2026!;TrustServerCertificate=True;Encrypt=True"
  },
  "Authentication": {
    "Authority": "http://health-gateway:5600",
    "SecretKey": "${JWT_SECRET_KEY}"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}",
    "ExchangeName": "health_exchange",
    "QueueName": "checkup_queue",
    "RoutingKey": "checkup.*"
  },
  "Redis": {
    "Configuration": "redis:6379",
    "CacheKeyPrefix": "health_checkup",
    "DefaultExpirationMinutes": 60
  }
}
