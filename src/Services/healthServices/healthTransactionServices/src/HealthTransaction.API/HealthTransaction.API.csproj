  <ItemGroup>
    <ProjectReference Include="..\HealthTransaction.Application\HealthTransaction.Application.csproj" />
    <ProjectReference Include="..\HealthTransaction.Infrastructure\HealthTransaction.Infrastructure.csproj" />
  </ItemGroup>

</Project>
