{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=HEALTHDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Application Name=\"Insurance Service\";Command Timeout=0"
  },
  "Authentication": {
    "Authority": "https://localhost:7001",
    "Audience": "insurance-api"
  },
  "RabbitMQ": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=storageaccount;AccountKey=accountkey;EndpointSuffix=core.windows.net",
    "ContainerName": "insurance-images"
  },
  "CircuitBreaker": {
    "HandledEventsAllowedBeforeBreaking": 3,
    "DurationOfBreakInSeconds": 30
  }
}
