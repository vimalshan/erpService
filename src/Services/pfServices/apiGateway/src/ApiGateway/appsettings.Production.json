{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "OVERRIDE_VIA_ENV",
    "Issuer": "PFApiGateway",
    "Audience": "PFServiceClients",
    "ExpireMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 10
  },
  "ReverseProxy": {
    "Clusters": {
      "accounting-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://accounting-service:8080" }
        }
      },
      "bank-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://bank-service:8080" }
        }
      },
      "contribution-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://contribution-service:8080" }
        }
      },
      "investment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://investment-service:8080" }
        }
      },
      "loan-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://loan-service:8080" }
        }
      },
      "masterdata-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://masterdata-service:8080" }
        }
      },
      "member-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://member-service:8080" }
        }
      },
      "pftransactional-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://pftransactional-service:8080" }
        }
      },
      "settlement-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://settlement-service:8080" }
        }
      },
      "trust-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://trust-service:8080" }
        }
      }
    }
  }
}
