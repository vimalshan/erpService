{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YourSuperSecretKeyHereMustBeLongEnough256Bits!!",
    "Issuer": "PFApiGateway",
    "Audience": "PFServiceClients",
    "ExpireMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 10
  },
  "ResiliencePolicy": {
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelayInMilliseconds": 500
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDurationInSeconds": 60,
      "MinimumThroughput": 10,
      "BreakDurationInSeconds": 30
    },
    "Timeout": {
      "TimeoutInSeconds": 30
    },
    "Bulkhead": {
      "MaxParallelization": 50,
      "MaxQueuingActions": 25
    }
  },
  "ResponseCaching": {
    "DefaultDurationInSeconds": 60,
    "MaxBodySizeInBytes": 67108864
  }
}
