# ======================================
# Environment Variables for Docker Compose
# Copy this file to .env and update values
# ======================================

# SQL Server
SA_PASSWORD=YourStrong!Passw0rd

# RabbitMQ
RABBITMQ_USER=pfuser
RABBITMQ_PASS=pfpassword

# JWT
JWT_SECRET_KEY=YourProductionJwtSecretKeyThatIsAtLeast256BitsLong!!

# Azure Blob Storage
AZURE_BLOB_CONNECTION=UseDevelopmentStorage=true

# Container Registry (for deployment scripts)
REGISTRY=pfservices
TAG=latest
