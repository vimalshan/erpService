# ───────────────────────────────────────────────────────────────────────────────
# 8  GRAPHQL  /graphql
#   Banana Cake Pop UI: GET http://localhost:5042/graphql
# ───────────────────────────────────────────────────────────────────────────────

### 8.1 Query – get all guest cards
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "{ guestCards { canteenUnit cardSequence cardNumber cardName cardType reportingUnit reportingDepartment effectiveDate closingDate isActive } }"
}

###

### 8.2 Query – get guest cards with pagination
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "query GetCards($page: Int!, $size: Int!) { guestCards(pageNumber: $page, pageSize: $size) { canteenUnit cardNumber cardName isActive } }",
  "variables": { "page": 1, "size": 2 }
}

###

### 8.3 Query – get guest card by id
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "query GetCard($id: Long!) { guestCardById(canteenUnit: $id) { canteenUnit cardNumber cardName cardType effectiveDate isActive } }",
  "variables": { "id": 1001 }
}

###

### 8.4 Query – filter with where clause (HotChocolate filtering)
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "{ guestCards(where: { isActive: { eq: true } }) { canteenUnit cardNumber cardName isActive } }"
}

###

### 8.5 Query – sort cards by cardName ascending
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "{ guestCards(order: [{ cardName: ASC }]) { canteenUnit cardNumber cardName } }"
}

###

### 8.6 Mutation – create guest card
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "mutation CreateCard($cmd: CreateGuestCardCommandInput!) { createGuestCard(command: $cmd) { canteenUnit cardNumber cardName isActive } }",
  "variables": {
    "cmd": {
      "canteenUnit": 3001,
      "cardSequence": 20,
      "cardNumber": "CARD-GQL-001",
      "cardName": "GraphQL Test Card",
      "cardType": "G",
      "reportingUnit": "QA",
      "reportingDepartment": 99,
      "effectiveDate": "2026-03-26T00:00:00Z"
    }
  }
}

###

### 8.7 Mutation – close guest card
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "mutation CloseCard($id: Long!) { closeGuestCard(canteenUnit: $id) }",
  "variables": { "id": 3001 }
}

###

### 8.8 Mutation – settle card
POST {{baseUrl}}/graphql
Authorization: {{authHeader}}
Content-Type: application/json

{
  "query": "mutation Settle($cmd: SettleCardCommandInput!) { settleCard(command: $cmd) { sysId canteenUnit cardNumber settlementDate } }",
  "variables": {
    "cmd": {
      "sysId": 2001,
      "canteenUnit": 1002,
      "cardNumber": "CARD-002",
      "settlementDate": "2026-03-26T00:00:00Z"
    }
  }
}

###

### 8.9 GraphQL introspection – list all queries and mutations
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "{ __schema { queryType { fields { name description args { name type { name kind ofType { name kind } } } } } mutationType { fields { name description args { name type { name kind ofType { name kind } } } } } } }"
}

###

# ───────────────────────────────────────────────────────────────────────────────
# 9  EDGE CASES
# ───────────────────────────────────────────────────────────────────────────────

### 9.1 PUT mismatch – route id ≠ body id (expect 400)
PUT {{baseUrl}}/api/GuestCards/1001
Authorization: {{authHeader}}
Content-Type: application/json

{
  "canteenUnit": 9999,
  "cardName": "Mismatch Test",
  "cardType": "G"
}

###

### 9.2 POST duplicate card (create 2001 again – expect 409 or 400)
POST {{baseUrl}}/api/GuestCards
Authorization: {{authHeader}}
Content-Type: application/json

{
  "canteenUnit": 2001,
  "cardSequence": 10,
  "cardNumber": "CARD-TEST-001",
  "cardName": "Duplicate",
  "cardType": "G",
  "effectiveDate": "2026-01-01T00:00:00Z"
}

###
