POST {{baseUrl}}/api/Settlements
Authorization: {{authHeader}}
Content-Type: application/json

{
  "sysId": 1001,
  "canteenUnit": 1001,
  "cardNumber": "CARD-001",
  "settlementDate": "2026-03-26T00:00:00Z"
}

