    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "ConnectionString": "amqp://guest:guest@localhost:5672"
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "transaction-documents"
  },
  "HealthChecks": {
    "Enabled": true
  }
}