{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "travel-request-route": {
        "ClusterId": "travelRequestCluster",
        "Match": { "Path": "/yarp/travelrequests/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/travelrequests" }, { "PathPrefix": "/api/travelrequests" }]
      },
      "travel-transaction-route": {
        "ClusterId": "travelTransactionCluster",
        "Match": { "Path": "/yarp/vendors/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/vendors" }, { "PathPrefix": "/api/vendors" }]
      },
      "booking-route": {
        "ClusterId": "bookingCluster",
        "Match": { "Path": "/yarp/bookings/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/bookings" }, { "PathPrefix": "/api/bookings" }]
      },
      "expense-route": {
        "ClusterId": "expenseCluster",
        "Match": { "Path": "/yarp/expenses/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/expenses" }, { "PathPrefix": "/api/expenses" }]
      },
      "finance-route": {
        "ClusterId": "financeCluster",
        "Match": { "Path": "/yarp/invoices/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/invoices" }, { "PathPrefix": "/api/invoices" }]
      },
      "insurance-route": {
        "ClusterId": "insuranceCluster",
        "Match": { "Path": "/yarp/insurance/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/insurance" }, { "PathPrefix": "/api/insurance" }]
      },
      "masterdata-route": {
        "ClusterId": "masterdataCluster",
        "Match": { "Path": "/yarp/masterdata/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/masterdata" }, { "PathPrefix": "/api" }]
      },
      "agency-route": {
        "ClusterId": "agencyCluster",
        "Match": { "Path": "/yarp/agency/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/agency" }, { "PathPrefix": "/api/agency" }]
      },
      "admin-route": {
        "ClusterId": "adminCluster",
        "Match": { "Path": "/yarp/admin/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/admin" }, { "PathPrefix": "/api" }]
      }
    },
    "Clusters": {
      "travelRequestCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://travel-request-api:8080" } }
      },
      "travelTransactionCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://travel-transaction-api:8080" } }
      },
      "bookingCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://booking-api:8080" } }
      },
      "expenseCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://expense-api:8080" } }
      },
      "financeCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://finance-api:8080" } }
      },
      "insuranceCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://insurance-api:8080" } }
      },
      "masterdataCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://masterdata-api:8080" } }
      },
      "agencyCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://agency-api:8080" } }
      },
      "adminCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": { "destination1": { "Address": "http://admin-api:8080" } }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Yarp": "Warning",
        "Ocelot": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
