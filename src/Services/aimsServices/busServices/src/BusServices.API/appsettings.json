{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BusDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=BUSDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Command Timeout=30",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpiresInMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "BusRegisteredQueue": "bus.registered",
    "EmployeeAssignedQueue": "bus.employee.assigned"
  }
}