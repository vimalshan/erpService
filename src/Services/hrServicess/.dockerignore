# Docker ignore file to exclude unnecessary files from build context

# Version control
.git
.gitignore
.gitattributes

# Build outputs
bin/
obj/
dist/
build/

# IDE files
.vscode/
.vs/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Package files
*.nupkg
node_modules/

# Test files
TestResults/
.coverage/

# logs
logs/
*.log

# Environment files (keep .env.example)
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Docker
.docker/
docker-compose.override.yml

# User-specific files
*.suo
*.user
.ClassDiagram

# Deployment directory (not needed in context)
deployment/README.md
deployment/scripts/
deployment/k8s/

# Documentation
docs/
*.md
LICENSE
CHANGELOG.md

# CI/CD
.github/
.gitlab-ci.yml
.jenkinsfile
azure-pipelines.yml

# Temporary files
*.tmp
*.temp
*.bak
