# Environment variables for docker-compose
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ─── SQL Server ───────────────────────────────────────────────────────────────
SQL_SA_PASSWORD=LoanERP_StrongPass!2025

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── JWT (shared secret — all services accept this issuer) ───────────────────
JWT_SECRET=LoanTransactionService_SuperSecret_Key_2025!@#$

# ─── Docker Registry (for push/pull) ─────────────────────────────────────────
REGISTRY=localhost:5000
IMAGE_TAG=latest
