{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpirationMinutes": 60
  },

  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/"
  },

  "Services": {
    "LoanTransaction": { "HealthUrl": "http://localhost:5292/health" },
    "LoanApplication":  { "HealthUrl": "http://localhost:5282/health" },
    "LoanAccount":      { "HealthUrl": "http://localhost:5150/health" },
    "LoanDefinition":   { "HealthUrl": "http://localhost:5077/health" },
    "Document":         { "HealthUrl": "http://localhost:5280/health" },
    "Lov":              { "HealthUrl": "http://localhost:5008/health" },
    "Utility":          { "HealthUrl": "http://localhost:5143/health" }
  },

  "Gateway": {
    "Bulkhead": {
      "MaxConcurrentRequests": 50
    },
    "RateLimiting": {
      "Anonymous": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "Authenticated": {
        "TokenLimit": 200,
        "TokensPerPeriod": 10,
        "ReplenishmentSeconds": 1
      },
      "Mutations": {
        "MaxConcurrent": 10
      },
      "GraphQL": {
        "PermitLimit": 30,
        "WindowSeconds": 30
      }
    },
    "Resilience": {
      "RetryCount": 3,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerOpenSeconds": 30,
      "RequestTimeoutSeconds": 30
    },
    "Cache": {
      "SizeLimitMb": 128,
      "MaxBodySizeBytes": 1048576,
      "DefaultExpirySeconds": 60,
      "ListExpirySeconds": 30,
      "ReferenceExpirySeconds": 300
    }
  },

  "ReverseProxy": {
    "Routes": {

      // ── Loan Transaction Service ─────────────────────────────────────────
      "loan-transaction-rest": {
        "ClusterId": "loan-transaction-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "OutputCachePolicy": "no-cache",
        "Match": {
          "Path": "/api/transactions/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          { "RequestHeader": "X-Gateway-Source", "Set": "LoanApiGateway" },
          { "RequestHeader": "X-Gateway-Version", "Set": "1.0" }
        ]
      },
      "loan-transaction-auth": {
        "ClusterId": "loan-transaction-cluster",
        "RateLimiterPolicy": "anonymous",
        "Match": {
          "Path": "/api/transactions/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "loan-transaction-graphql": {
        "ClusterId": "loan-transaction-cluster",
        "RateLimiterPolicy": "graphql",
        "OutputCachePolicy": "no-cache",
        "Match": {
          "Path": "/api/transactions/graphql"
        },
        "Transforms": [
          { "PathPattern": "/graphql" }
        ]
      },
      "loan-transaction-health": {
        "ClusterId": "loan-transaction-cluster",
        "Match": {
          "Path": "/api/transactions/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── Loan Application Service ─────────────────────────────────────────
      "loan-application-rest": {
        "ClusterId": "loan-application-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "OutputCachePolicy": "no-cache",
        "Match": {
          "Path": "/api/applications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "loan-application-graphql": {
        "ClusterId": "loan-application-cluster",
        "RateLimiterPolicy": "graphql",
        "Match": {
          "Path": "/api/applications/graphql"
        },
        "Transforms": [
          { "PathPattern": "/graphql" }
        ]
      },
      "loan-application-health": {
        "ClusterId": "loan-application-cluster",
        "Match": {
          "Path": "/api/applications/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── Loan Account Service ─────────────────────────────────────────────
      "loan-account-rest": {
        "ClusterId": "loan-account-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "OutputCachePolicy": "no-cache",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "loan-account-health": {
        "ClusterId": "loan-account-cluster",
        "Match": {
          "Path": "/api/accounts/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── Loan Definition Service ──────────────────────────────────────────
      "loan-definition-rest": {
        "ClusterId": "loan-definition-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "OutputCachePolicy": "list-cache",
        "Match": {
          "Path": "/api/definitions/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "loan-definition-graphql": {
        "ClusterId": "loan-definition-cluster",
        "RateLimiterPolicy": "graphql",
        "OutputCachePolicy": "list-cache",
        "Match": {
          "Path": "/api/definitions/graphql"
        },
        "Transforms": [
          { "PathPattern": "/graphql" }
        ]
      },
      "loan-definition-health": {
        "ClusterId": "loan-definition-cluster",
        "Match": {
          "Path": "/api/definitions/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── Document Service ─────────────────────────────────────────────────
      "document-rest": {
        "ClusterId": "document-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "RateLimiterPolicy": "authenticated",
        "OutputCachePolicy": "no-cache",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "document-health": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/api/documents/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── LOV Service ──────────────────────────────────────────────────────
      "lov-rest": {
        "ClusterId": "lov-cluster",
        "OutputCachePolicy": "reference-cache",
        "RateLimiterPolicy": "anonymous",
        "Match": {
          "Path": "/api/lovs/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "lov-graphql": {
        "ClusterId": "lov-cluster",
        "RateLimiterPolicy": "graphql",
        "OutputCachePolicy": "reference-cache",
        "Match": {
          "Path": "/api/lovs/graphql"
        },
        "Transforms": [
          { "PathPattern": "/graphql" }
        ]
      },
      "lov-health": {
        "ClusterId": "lov-cluster",
        "Match": {
          "Path": "/api/lovs/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },

      // ── Utility Service ──────────────────────────────────────────────────
      "utility-rest": {
        "ClusterId": "utility-cluster",
        "RateLimiterPolicy": "anonymous",
        "OutputCachePolicy": "list-cache",
        "Match": {
          "Path": "/api/utility/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "utility-health": {
        "ClusterId": "utility-cluster",
        "Match": {
          "Path": "/api/utility/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      }
    },

    "Clusters": {

      // ── Loan Transaction (Round Robin across ports 5292 / 5393 for scale-out) ──
      "loan-transaction-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "HttpClient": {
          "SslProtocols": [ "Tls12", "Tls13" ]
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "loan-transaction-primary": {
            "Address": "http://localhost:5292/"
          }
        }
      },

      // ── Loan Application ────────────────────────────────────────────────
      "loan-application-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "loan-application-primary": {
            "Address": "http://localhost:5282/"
          }
        }
      },

      // ── Loan Account ─────────────────────────────────────────────────────
      "loan-account-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "loan-account-primary": {
            "Address": "http://localhost:5150/"
          }
        }
      },

      // ── Loan Definition ──────────────────────────────────────────────────
      "loan-definition-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "loan-definition-primary": {
            "Address": "http://localhost:5077/"
          }
        }
      },

      // ── Document Service ─────────────────────────────────────────────────
      "document-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        },
        "Destinations": {
          "document-primary": {
            "Address": "http://localhost:5280/"
          }
        }
      },

      // ── LOV Service ──────────────────────────────────────────────────────
      "lov-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "Destinations": {
          "lov-primary": {
            "Address": "http://localhost:5008/"
          }
        }
      },

      // ── Utility Service ──────────────────────────────────────────────────
      "utility-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "Destinations": {
          "utility-primary": {
            "Address": "http://localhost:5143/"
          }
        }
      }
    }
  }
}
