{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET}",
    "Issuer": "LoanTransactionAPI",
    "Audience": "LoanTransactionClient",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://${RABBITMQ_USER:-guest}:${RABBITMQ_PASS:-guest}@rabbitmq:5672/",
    "ManagementUrl": "http://rabbitmq:15672/api/healthchecks/node"
  },
  "Gateway": {
    "Bulkhead": { "MaxConcurrentRequests": 100 },
    "RateLimiting": {
      "Anonymous":      { "PermitLimit": 60,  "WindowSeconds": 60 },
      "Authenticated":  { "TokenLimit": 200,  "TokensPerPeriod": 10, "ReplenishmentSeconds": 1 },
      "Mutations":      { "MaxConcurrent": 10 },
      "GraphQL":        { "PermitLimit": 30,  "WindowSeconds": 30 }
    },
    "Resilience": {
      "RetryCount": 3,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerOpenSeconds": 30,
      "RequestTimeoutSeconds": 30
    },
    "Cache": {
      "SizeLimitMb": 256,
      "DefaultExpirySeconds": 60,
      "ListExpirySeconds": 30,
      "ReferenceExpirySeconds": 300
    }
  }
}
