{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=${SQL_HOST:-sqlserver},1433;Database=LOANDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;Connection Timeout=30;Pooling=True;Max Pool Size=100;"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST:-rabbitmq}",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "${RABBITMQ_USER:-guest}",
    "Password": "${RABBITMQ_PASS:-guest}",
    "ExchangeName": "utility.exchange",
    "QueueName": "utility.toadplan.events",
    "DeadLetterExchange": "utility.dlx"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "UtilityService",
    "Audience": "UtilityServiceUsers",
    "ExpiryHours": 1
  }
}
