{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "LovDb": "Server=${SQL_HOST:-sqlserver},1433;Database=LOANDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;Connection Timeout=30;Pooling=True;Max Pool Size=100;"
  },
  "RabbitMQ": {
    "Enabled": true,
    "Host": "${RABBITMQ_HOST:-rabbitmq}",
    "VirtualHost": "/",
    "Username": "${RABBITMQ_USER:-guest}",
    "Password": "${RABBITMQ_PASS:-guest}"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET}",
    "Issuer": "LovService",
    "Audience": "LovServiceClients"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
