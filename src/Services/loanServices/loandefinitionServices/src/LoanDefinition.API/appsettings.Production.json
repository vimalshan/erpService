{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "LoanDb": "Server=${SQL_HOST:-sqlserver},1433;Database=LOANDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;Connection Timeout=30;Pooling=True;Max Pool Size=100;"
  },
  "RabbitMq": {
    "HostName": "${RABBITMQ_HOST:-rabbitmq}",
    "Port": 5672,
    "UserName": "${RABBITMQ_USER:-guest}",
    "Password": "${RABBITMQ_PASS:-guest}",
    "VirtualHost": "/"
  },
  "Jwt": {
    "Key": "${JWT_SECRET}",
    "Issuer": "LoanDefinitionService",
    "Audience": "LoanDefinitionClients",
    "ExpireMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/loan-definition-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
