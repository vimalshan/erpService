{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LoanAccountDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=LOANDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Application Name=\"Loan Account Service\";Command Timeout=0"
  },
  "JwtSettings": {
    "SecretKey": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "loan-account-events",
    "ExchangeName": "loan-account-exchange"
  },
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=storageaccount;AccountKey=key;EndpointSuffix=core.windows.net",
    "ContainerName": "loan-documents",
    "BlobPrefix": "loans/"
  },
  "HealthCheck": {
    "Enabled": true,
    "Interval": 30
  },
  "Polly": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeoutSeconds": 30
  }
}