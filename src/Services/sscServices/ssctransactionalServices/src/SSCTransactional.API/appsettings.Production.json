{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SSCDB;User Id=sa;Password=REPLACE_SA_PASSWORD;TrustServerCertificate=True;Encrypt=True",
    "AzureBlobStorage": "DefaultEndpointsProtocol=https;AccountName=REPLACE_ACCOUNT;AccountKey=REPLACE_KEY;EndpointSuffix=core.windows.net"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_PRODUCTION_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "SSCTransactionalService",
    "Audience": "SSCTransactionalServiceClients",
    "ExpiryHours": 8
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "ssc_user",
    "Password": "REPLACE_RABBITMQ_PASSWORD",
    "VirtualHost": "/",
    "TransactionExchange": "transaction.exchange"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
