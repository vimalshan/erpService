{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "JwtSettings": {
    "Secret": "SSCMicroservicesSuperSecretKey2026!@#$%^&*GatewayShared",
    "Issuer": "SSCServices",
    "Audience": "SSCClients",
    "ValidIssuers": [
      "SSCServices",
      "SSCTransactionalService",
      "BatchAndEnvelopeService",
      "CategoryAndVendorService",
      "ClubMembershipService",
      "FilingAndArchiveService",
      "HRDocumentService",
      "IntegrationService",
      "InvoiceProcessing.API",
      "MasterDataService",
      "MenuAndSecurityService",
      "ApprovalGroupService",
      "UserService"
    ],
    "ValidAudiences": [
      "SSCClients",
      "SSCTransactionalServiceClients",
      "BatchAndEnvelopeServiceClients",
      "CategoryAndVendorServiceClients",
      "ClubMembershipServiceClients",
      "FilingAndArchiveServiceClients",
      "HRDocumentServiceClients",
      "IntegrationServiceClients",
      "InvoiceProcessing.Clients",
      "MasterDataServiceClients",
      "MenuAndSecurityServiceClients",
      "ApprovalGroupServiceClients",
      "UserServiceClients"
    ]
  },

  "RateLimiting": {
    "EnableRateLimiting": true,
    "GlobalPolicy": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueLimit": 10
    },
    "AuthenticatedPolicy": {
      "PermitLimit": 500,
      "Window": 60,
      "QueueLimit": 25
    },
    "StrictPolicy": {
      "PermitLimit": 10,
      "Window": 60,
      "QueueLimit": 2
    }
  },

  "Resilience": {
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": 30,
      "MinimumThroughput": 10,
      "BreakDuration": 15
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": 1,
      "BackoffType": "Exponential"
    },
    "Timeout": {
      "TimeoutSeconds": 30
    },
    "Bulkhead": {
      "MaxParallelization": 50,
      "MaxQueuingActions": 25
    }
  },

  "HealthCheckEndpoints": {
    "SqlServer": "Server=sqlserver;Database=SSCDB;User Id=sa;Password=SSCAdmin@2026!;TrustServerCertificate=True",
    "RabbitMQ": "amqp://ssc_user:ssc_password@rabbitmq:5672/"
  },

  "ServiceUrls": {
    "SSCTransactional": "http://ssc-transactional:8080",
    "BatchAndEnvelope": "http://batch-and-envelope:8080",
    "CategoryAndVendor": "http://category-and-vendor:8080",
    "ClubMembership": "http://club-membership:8080",
    "FilingAndArchive": "http://filing-and-archive:8080",
    "HRDocument": "http://hr-document:8080",
    "IntegrationService": "http://integration-service:8080",
    "InvoiceProcessing": "http://invoice-processing:8080",
    "MasterData": "http://master-data:8080",
    "MenuAndSecurity": "http://menu-and-security:8080",
    "ApprovalGroup": "http://approval-group:8080",
    "UserService": "http://user-service:8080"
