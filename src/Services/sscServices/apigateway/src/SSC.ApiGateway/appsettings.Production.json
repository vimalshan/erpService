{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning",
        "SSC.ApiGateway": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "JwtSettings": {
    "Secret": "REPLACE_JWT_SECRET",
    "Issuer": "SSCServices",
    "Audience": "SSCClients",
    "ValidIssuers": [
      "SSCServices",
      "SSCTransactionalService",
      "BatchAndEnvelopeService",
      "CategoryAndVendorService",
      "ClubMembershipService",
      "FilingAndArchiveService",
      "HRDocumentService",
      "IntegrationService",
      "InvoiceProcessing.API",
      "MasterDataService",
      "MenuAndSecurityService",
      "ApprovalGroupService",
      "UserService"
    ],
    "ValidAudiences": [
      "SSCClients",
      "SSCTransactionalServiceClients",
      "BatchAndEnvelopeServiceClients",
      "CategoryAndVendorServiceClients",
      "ClubMembershipServiceClients",
      "FilingAndArchiveServiceClients",
      "HRDocumentServiceClients",
      "IntegrationServiceClients",
      "InvoiceProcessing.Clients",
      "MasterDataServiceClients",
      "MenuAndSecurityServiceClients",
      "ApprovalGroupServiceClients",
      "UserServiceClients"
    ]
  },

  "HealthCheckEndpoints": {
    "SqlServer": "REPLACE_SQL_CONNECTION_STRING",
    "RabbitMQ": "REPLACE_RABBITMQ_CONNECTION_STRING"
  },

  "RateLimiting": {
    "EnableRateLimiting": true,
    "GlobalPolicy": {
      "PermitLimit": 100,
      "Window": 60,
      "QueueLimit": 10
    },
    "AuthenticatedPolicy": {
      "PermitLimit": 500,
      "Window": 60,
      "QueueLimit": 25
    },
    "StrictPolicy": {
      "PermitLimit": 10,
      "Window": 60,
      "QueueLimit": 2
    }
  },

  "Resilience": {
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDuration": 30,
      "MinimumThroughput": 10,
      "BreakDuration": 15
    },
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": 1,
      "BackoffType": "Exponential"
    },
    "Timeout": {
      "TimeoutSeconds": 30
    },
    "Bulkhead": {
      "MaxParallelization": 50,
      "MaxQueuingActions": 25
    }
  },

  "AllowedHosts": "*"
}
