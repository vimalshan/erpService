{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SSCDB_InvoiceProcessing;User Id=sa;Password=REPLACE_SA_PASSWORD;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_PRODUCTION_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "InvoiceProcessing.API",
    "Audience": "InvoiceProcessing.Clients",
    "ExpiryMinutes": "60"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": "5672",
    "UserName": "ssc_user",
    "Password": "REPLACE_RABBITMQ_PASSWORD"
  },
  "AzureBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=REPLACE_ACCOUNT;AccountKey=REPLACE_KEY;EndpointSuffix=core.windows.net",
    "InvoiceContainerName": "invoice-documents"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
