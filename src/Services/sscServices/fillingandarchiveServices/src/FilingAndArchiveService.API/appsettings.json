{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SSCDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "JwtSettings": {
    "Secret": "FilingArchiveService-SuperSecret-Key-32Characters!!",
    "Issuer": "FilingAndArchiveService",
    "Audience": "FilingAndArchiveServiceClients",
    "ExpiryMinutes": "60"
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "FilingDocumentsContainer": "filing-documents"
  },
  "Polly": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  }
}

