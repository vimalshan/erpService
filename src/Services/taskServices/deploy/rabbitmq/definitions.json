        "x-dead-letter-exchange": "erp.events.dlx",
        "x-dead-letter-routing-key": "dlx.task.mail.created",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "task.mail.updated",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "erp.events.dlx",
        "x-dead-letter-routing-key": "dlx.task.mail.updated",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "energy.reading.created",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "erp.events.dlx",
        "x-dead-letter-routing-key": "dlx.energy.reading.created",
        "x-message-ttl": 86400000
      }
    },
