        "x-dead-letter-exchange": "erp.events.dlx",
        "x-dead-letter-routing-key": "dlx.unit.updated",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "lookup.changed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
