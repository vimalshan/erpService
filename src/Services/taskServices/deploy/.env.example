# Copy to .env and set real values before deploying
# NEVER commit .env to source control

# SQL Server
SQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_PID=Express

# RabbitMQ
RABBITMQ_USER=erp_admin
RABBITMQ_PASS=ErpR@bbit2024!

# JWT
JWT_SECRET_KEY=ERP-Microservice-Shared-JWT-Secret-Key-For-Authentication-2024!

