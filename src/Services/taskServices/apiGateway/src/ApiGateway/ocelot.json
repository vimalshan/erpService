{
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "RequestIdKey": "X-Correlation-ID",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "API rate limit exceeded. Please retry after the rate limit window resets.",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Client-Id"
    },
    "QoSOptions": {
      "ExceptionsAllowedBeforeBreaking": 5,
      "DurationOfBreak": 30000,
      "TimeoutValue": 30000
    },
    "LoadBalancerOptions": {
      "Type": "RoundRobin"
    },
    "HttpHandlerOptions": {
      "AllowAutoRedirect": false,
      "UseCookieContainer": false,
      "UseTracing": true
    }
  },

  "Routes": [
    {
      "UpstreamPathTemplate": "/ocelot/lookup/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH" ],
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5188 },
        { "Host": "localhost", "Port": 5189 }
      ],
      "LoadBalancerOptions": { "Type": "RoundRobin" },
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 100,
        "ClientWhitelist": []
      },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 5,
        "DurationOfBreak": 30000,
        "TimeoutValue": 30000
      },
      "FileCacheOptions": {
        "TtlSeconds": 60,
        "Region": "lookup"
      },
      "Key": "lookup-rest"
    },
    {
      "UpstreamPathTemplate": "/ocelot/lookup/graphql",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/graphql",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5188 }
      ],
      "Key": "lookup-graphql"
    },
    {
      "UpstreamPathTemplate": "/ocelot/lookup/health",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5188 }
      ],
      "Key": "lookup-health"
    },

