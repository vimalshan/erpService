{
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "ERP-Gateway",
    "Audience": "ERP-Services"
  },

  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}"
  },

  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 60,
    "QueueLimit": 20
  },

  "CircuitBreaker": {
    "HandledEventsAllowedBeforeBreaking": 10,
    "DurationOfBreakSeconds": 60
  },

  "Retry": {
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2
  },

  "Bulkhead": {
    "MaxParallelization": 50,
    "MaxQueuingActions": 100
  },

  "Timeout": {
    "Seconds": 60
  },

  "Caching": {
    "DefaultDurationSeconds": 120
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Warning",
        "Ocelot": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Clusters": {
      "lookup-cluster": {
        "Destinations": {
          "lookup-1": { "Address": "http://lookup-service:8080/", "Health": "http://lookup-service:8080/" },
          "lookup-2": { "Address": "http://lookup-service-2:8080/", "Health": "http://lookup-service-2:8080/" }
        }
      },
      "task-cluster": {
        "Destinations": {
          "task-1": { "Address": "http://task-service:8080/", "Health": "http://task-service:8080/" },
          "task-2": { "Address": "http://task-service-2:8080/", "Health": "http://task-service-2:8080/" }
        }
      },
      "transactional-cluster": {
        "Destinations": {
          "transactional-1": { "Address": "http://transactional-service:8080/", "Health": "http://transactional-service:8080/" },
          "transactional-2": { "Address": "http://transactional-service-2:8080/", "Health": "http://transactional-service-2:8080/" }
        }
      },
      "complaint-cluster": {
        "Destinations": {
          "complaint-1": { "Address": "http://complaint-service:8080/", "Health": "http://complaint-service:8080/" },
          "complaint-2": { "Address": "http://complaint-service-2:8080/", "Health": "http://complaint-service-2:8080/" }
        }
      },
      "energy-cluster": {
        "Destinations": {
          "energy-1": { "Address": "http://energy-service:8080/", "Health": "http://energy-service:8080/" },
          "energy-2": { "Address": "http://energy-service-2:8080/", "Health": "http://energy-service-2:8080/" }
        }
      },
      "unit-cluster": {
        "Destinations": {
          "unit-1": { "Address": "http://unit-service:8080/", "Health": "http://unit-service:8080/" },
          "unit-2": { "Address": "http://unit-service-2:8080/", "Health": "http://unit-service-2:8080/" }
        }
      }
    }
  }
}
