{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=TASKDB;User Id=sa;Password=${SQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True;Application Name=UnitService;Command Timeout=30;Max Pool Size=100"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET_KEY}",
    "Issuer": "ERP-Gateway",
    "Audience": "ERP-Services",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}"
  },
  "AzureBlobStorage": {
    "ConnectionString": "${AZURE_BLOB_CONNECTION_STRING}",
    "ContainerName": "equipment-images"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
