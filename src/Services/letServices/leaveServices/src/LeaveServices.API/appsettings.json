{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LeaveDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=LETDB;Integrated Security=True;TrustServerCertificate=True",
    "AzureBlobStorage": "UseDevelopmentStorage=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "LeaveExchange": "leave.events",
    "EncashmentQueue": "leave.encashment.events",
    "LopQueue": "leave.lop.events"
  },
  "Jwt": {
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "ExpiryMinutes": 60
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "DocumentContainer": "leave-documents"
  },
  "HealthChecks": {
    "SqlServerTimeout": 5
  }
}