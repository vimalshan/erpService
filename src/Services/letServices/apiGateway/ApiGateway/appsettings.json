{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "SuperSecretJwtKeyForLetTransactionService_ChangeInProduction!",
    "Issuer": "LetTransactionService",
    "Audience": "LetTransactionServiceClients"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*/auth/*",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "leave-route": {
        "ClusterId": "leave-cluster",
        "Match": { "Path": "/api/leave/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "LeaveService" }
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": { "Path": "/api/courses/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/courses/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "CourseService" }
      },
      "request-route": {
        "ClusterId": "request-cluster",
        "Match": { "Path": "/api/requests/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/requests/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "RequestService" }
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "ReviewService" }
      },
      "review-feedback-route": {
        "ClusterId": "review-cluster",
        "Match": { "Path": "/api/review-feedback/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/feedback/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "ReviewService" }
      },
      "development-route": {
        "ClusterId": "development-cluster",
        "Match": { "Path": "/api/development/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "DevelopmentService" }
      },
      "master-route": {
        "ClusterId": "master-cluster",
        "Match": { "Path": "/api/master/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "MasterService" }
      },
      "master-financial-years-route": {
        "ClusterId": "master-cluster",
        "Match": { "Path": "/api/financial-years/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/financial-years/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "MasterService" }
      },
      "let-transaction-route": {
        "ClusterId": "let-transaction-cluster",
        "Match": { "Path": "/api/let/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "LetTransactionService" }
      },
      "let-graphql-route": {
        "ClusterId": "let-transaction-cluster",
        "Match": { "Path": "/graphql/let/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/graphql/{**catch-all}" }
        ],
        "Metadata": { "ServiceName": "LetTransactionService" }
      }
    },
    "Clusters": {
      "leave-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "leave-d1": { "Address": "http://localhost:5166" }
        }
      },
      "course-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "course-d1": { "Address": "http://localhost:5215" }
        }
      },
      "request-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "request-d1": { "Address": "http://localhost:5006" }
        }
      },
      "review-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "review-d1": { "Address": "http://localhost:5114" }
        }
      },
      "development-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "development-d1": { "Address": "http://localhost:5216" }
        }
      },
      "master-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "master-d1": { "Address": "http://localhost:5279" }
        }
      },
      "let-transaction-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "BulkheadMaxParallelization": "20", "BulkheadMaxQueuingActions": "10" },
        "Destinations": {
          "let-d1": { "Address": "http://localhost:5320" }
        }
      }
    }
  }
}
