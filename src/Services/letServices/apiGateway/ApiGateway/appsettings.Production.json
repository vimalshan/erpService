{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "REPLACE_VIA_ENV",
    "Issuer": "LET-ERP-Gateway",
    "Audience": "LET-ERP-Services"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 300 },
      { "Endpoint": "*", "Period": "1s", "Limit": 20 },
      { "Endpoint": "*/auth/*", "Period": "1m", "Limit": 30 }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "leave-route": {
        "ClusterId": "leave-cluster",
        "Match": { "Path": "/api/leave/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": { "Path": "/api/courses/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/courses/{**catch-all}" } ]
      },
      "request-route": {
        "ClusterId": "request-cluster",
        "Match": { "Path": "/api/requests/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/requests/{**catch-all}" } ]
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "development-route": {
        "ClusterId": "development-cluster",
        "Match": { "Path": "/api/development/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "master-route": {
        "ClusterId": "master-cluster",
        "Match": { "Path": "/api/master/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "master-financial-years-route": {
        "ClusterId": "master-cluster",
        "Match": { "Path": "/api/financial-years/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/financial-years/{**catch-all}" } ]
      },
      "let-transaction-route": {
        "ClusterId": "let-transaction-cluster",
        "Match": { "Path": "/api/let/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
      },
      "let-graphql-route": {
        "ClusterId": "let-transaction-cluster",
        "Match": { "Path": "/graphql/let/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/graphql/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "leave-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "leave-d1": { "Address": "http://leave-service:8080" } }
      },
      "course-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "course-d1": { "Address": "http://course-service:8080" } }
      },
      "request-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "request-d1": { "Address": "http://request-service:8080" } }
      },
      "review-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "review-d1": { "Address": "http://review-service:8080" } }
      },
      "development-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "development-d1": { "Address": "http://development-service:8080" } }
      },
      "master-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "master-d1": { "Address": "http://master-service:8080" } }
      },
      "let-transaction-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:10", "Path": "/health" } },
        "Destinations": { "let-d1": { "Address": "http://let-transaction-service:8080" } }
      }
    }
  }
}
