{
  "ConnectionStrings": {
    "CourseDb": "Server=(localdb)\\MSSQLLocalDB;Database=LETDB;Integrated Security=True;TrustServerCertificate=True;",
    "AzureBlob": ""
  },
  "JwtSettings": {
    "SecretKey": "CourseService_JWT_SecretKey_ChangeInProduction_32chars!",
    "Issuer": "CourseService",
    "Audience": "CourseServiceClients",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "course.events"
  },
  "Polly": {
    "RetryCount": 3,
    "RetryDelaySeconds": 2,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
