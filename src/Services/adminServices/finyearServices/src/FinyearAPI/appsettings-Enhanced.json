{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AdminDbConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ADMINDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Application Name=\"FinyearAPI\";Command Timeout=0",
    "AzureBlobStorage": "DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-jwt-key-change-this-in-production-at-least-32-characters",
    "Issuer": "FinyearAPI",
    "Audience": "FinyearAPIClients",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "your-instrumentation-key-here"
  },
  "Swagger": {
    "Title": "Financial Year API",
    "Description": "Enterprise API with CQRS, DDD, GraphQL, and Resilience Patterns",
    "Version": "1.0.0",
    "Contact": {
      "Name": "API Support",
      "Email": "support@example.com"
    }
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true
  },
  "Resilience": {
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "BreakDurationSeconds": 30
    },
    "Retry": {
      "MaxRetries": 3,
      "InitialDelayMilliseconds": 1000
    }
  }
}
