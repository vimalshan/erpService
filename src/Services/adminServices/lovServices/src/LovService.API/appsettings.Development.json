{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "LovDb": "Server=(localdb)\\MSSQLLocalDB;Database=LOVDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=LovService",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "RabbitMQ": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  }
}
