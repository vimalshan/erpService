{
  "ConnectionStrings": {
    "ScholarshipDb": "Server=<PRODUCTION_SERVER>;Database=ADMINDB;User Id=<PROD_USER>;Password=<PROD_PASSWORD>;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;"
  },
  "Jwt": {
    "Key": "<CHANGE_IN_PRODUCTION_SECRET_KEY_32_CHARS>",
    "Issuer": "ScholarshipService",
    "Audience": "ScholarshipServiceClient",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "<PRODUCTION_RABBITMQ_HOST>",
    "Port": 5672,
    "UserName": "<RABBITMQ_USER>",
    "Password": "<RABBITMQ_PASSWORD>",
    "VirtualHost": "/",
    "ExchangeName": "scholarship.events"
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=<STORAGE_ACCOUNT>;AccountKey=<STORAGE_KEY>;EndpointSuffix=core.windows.net",
      "ContainerName": "scholarship-files"
    }
  },
  "ApiGateway": {
    "BaseUrl": "<PRODUCTION_API_GATEWAY_URL>"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "<APPLICATION_INSIGHTS_KEY>"
  },
  "Cors": {
    "AllowedOrigins": [
      "<PRODUCTION_DOMAIN_1>",
      "<PRODUCTION_DOMAIN_2>"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  }
}
