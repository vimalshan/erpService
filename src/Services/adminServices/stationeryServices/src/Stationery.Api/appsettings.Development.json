{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "System": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=StationeryDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForStationeryServiceDevelopment2026!",
    "Issuer": "StationeryService",
    "Audience": "StationeryServiceUsers",
    "ExpiryInMinutes": 120
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:5174"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ],
    "AllowCredentials": true
  },
  "SwaggerSettings": {
    "Enabled": true,
    "Title": "Stationery Service API",
    "Version": "v1",
    "Description": "API for managing stationery requests, orders, and inventory"
  },
  "HealthCheck": {
    "Enabled": true,
    "Path": "/health"
  },
  "GraphQL": {
    "Enabled": true,
    "Path": "/graphql"
  },
  "Middleware": {
    "ExceptionHandling": {
      "Enabled": true,
      "IncludeStackTrace": true
    },
    "RequestLogging": {
      "Enabled": true
    }
  },
  "Database": {
    "AutoMigrate": true,
    "Seed": true
  }
}
