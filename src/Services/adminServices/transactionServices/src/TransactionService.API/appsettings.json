{
  "ConnectionStrings": {
    "TransactionDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ADMINDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=30"
  },
  "JwtSettings": {
    "Secret": "TransactionServiceSecretKey-ChangeInProduction-MinLength32Chars!",
    "Issuer": "TransactionService",
    "Audience": "TransactionServiceClients",
    "ExpiryInMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Enabled": true
  },
  "AzureBlob": {
    "ContainerName": "stationery-images"
  },
  "ExternalServices": {
    "VendorService": "http://localhost:5003",
    "LocationService": "http://localhost:5002",
    "FinyearService": "http://localhost:5001",
    "StationeryService": "http://localhost:5005",
    "LovService": "http://localhost:5007"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "GraphQL": {
    "Enabled": true,
    "Path": "/graphql"
  },
  "Database": {
    "AutoMigrate": true,
    "Seed": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
