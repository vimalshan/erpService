{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Debug",
      "Ocelot": "Debug",
      "ApiGateway": "Debug"
    }
  },
  "JwtSettings": {
    "SecretKey": "dev-secret-key-super-secret-super-long-key",
    "Issuer": "https://localhost:5000",
    "Audience": "erp-api-users-dev",
    "ExpirationMinutes": 120
  },
  "RateLimiting": {
    "Enabled": false,
    "RequestsPerMinute": 1000,
    "BurstSize": 100,
    "ClientIdHeader": "X-Client-ID"
  },
  "CircuitBreaker": {
    "FailureThreshold": 10,
    "SuccessThreshold": 2,
    "TimeoutSeconds": 60,
    "SamplingDurationSeconds": 120
  },
  "Serilog": {
    "MinimumLevel": "Debug"
  }
}
