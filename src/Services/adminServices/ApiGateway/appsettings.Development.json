{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Debug",
      "Ocelot": "Debug",
      "ApiGateway": "Debug"
    }
  },
  "JwtSettings": {
    "SecretKey": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpirationMinutes": 120
  },
  "RateLimiting": {
    "Enabled": false,
    "RequestsPerMinute": 1000,
    "BurstSize": 100,
    "ClientIdHeader": "X-Client-ID"
  },
  "CircuitBreaker": {
    "FailureThreshold": 10,
    "SuccessThreshold": 2,
    "TimeoutSeconds": 60,
    "SamplingDurationSeconds": 120
  },
  "Services": {
    "FinyearService": {
      "Url": "http://localhost:5100"
    },
    "LocationService": {
      "Url": "http://localhost:5100"
    },
    "VendorService": {
      "Url": "http://localhost:5100"
    },
    "ScholarshipService": {
      "Url": "http://localhost:5100"
    },
    "StationeryService": {
      "Url": "http://localhost:5100"
    },
    "TDSService": {
      "Url": "http://localhost:5100"
    },
    "LOVService": {
      "Url": "http://localhost:5100"
    },
    "SharedService": {
      "Url": "http://localhost:5100"
    },
    "TransactionService": {
      "Url": "http://localhost:5100"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug"
  }
}