{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=CASHDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Application Name=ApiGateway"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJWTTokenGeneration2026!@#$%^&*()",
    "Issuer": "ApiGatewayService",
    "Audience": "ApiGatewayClients",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "apigateway.exchange",
    "QueueName": "apigateway.queue"
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "gateway-logs"
    }
  },
  "ServiceEndpoints": {
    "CashManagement": "http://localhost:5249",
    "CurrencyManagement": "http://localhost:5031",
    "DealTicketing": "http://localhost:5081",
    "LoanManagement": "http://localhost:5268",
    "OrganizationSetup": "http://localhost:5099",
    "EmailNotification": "http://localhost:5032"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10,
    "TokenPermitLimit": 20,
    "TokenReplenishSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "cash-route": {
        "ClusterId": "cash-cluster",
        "Match": {
          "Path": "/api/v1/cash/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/cash" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "cash-graphql-route": {
        "ClusterId": "cash-cluster",
        "Match": {
          "Path": "/graphql/cash/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/graphql/cash" },
          { "PathPrefix": "/graphql" }
        ]
      },
      "currency-route": {
        "ClusterId": "currency-cluster",
        "Match": {
          "Path": "/api/v1/currency/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/currency" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "currency-graphql-route": {
        "ClusterId": "currency-cluster",
        "Match": {
          "Path": "/graphql/currency/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/graphql/currency" },
          { "PathPrefix": "/graphql" }
        ]
      },
      "deals-route": {
        "ClusterId": "deals-cluster",
        "Match": {
          "Path": "/api/v1/deals/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/deals" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "deals-graphql-route": {
        "ClusterId": "deals-cluster",
        "Match": {
          "Path": "/graphql/deals/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/graphql/deals" },
          { "PathPrefix": "/graphql" }
        ]
      },
      "loans-route": {
        "ClusterId": "loans-cluster",
        "Match": {
          "Path": "/api/v1/loans/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/loans" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "loans-graphql-route": {
        "ClusterId": "loans-cluster",
        "Match": {
          "Path": "/graphql/loans/{**catch-all}"
        },
        "Transforms": [
