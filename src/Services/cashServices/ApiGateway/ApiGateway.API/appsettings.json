        ]
      }
    },
    "Clusters": {
      "cash-cluster": {
        "Destinations": {
          "cash-primary": {
            "Address": "http://localhost:5249"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        }
      },
      "currency-cluster": {
        "Destinations": {
          "currency-primary": {
            "Address": "http://localhost:5031"
          }
        },
