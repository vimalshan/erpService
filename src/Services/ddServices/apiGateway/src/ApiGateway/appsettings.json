{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Ocelot": "Information"
    }
  },
  "JwtSettings": {
    "SecretKey": "your-very-long-secret-key-change-this-in-production-at-least-32-characters",
    "Issuer": "ApiGateway",
    "Audience": "ApiGatewayClients",
    "ExpiryMinutes": 60
  },
  "ServiceEndpoints": {
    "AuthorizationService": "http://localhost:5177",
    "TransactionService": "http://localhost:5178",
    "OtherService": "http://localhost:5224",
    "RecruitmentService": "http://localhost:5237",
    "DemandManagementService": "http://localhost:5210",
    "ObjectiveService": "http://localhost:5258",
    "CompetencyService": "http://localhost:5261",
    "DocumentService": "http://localhost:5081",
    "EmployeeService": "http://localhost:5049",
    "CompensationService": "http://localhost:5000",
    "AppraisalService": "http://localhost:5100",
    "FeedbackService": "http://localhost:5101",
    "LearningService": "http://localhost:5102",
    "PromotionService": "http://localhost:5103",
    "ReportingService": "http://localhost:5104"
  },
  "ReverseProxy": {
    "Routes": {
      "authorization-yarp": {
        "ClusterId": "authorization-cluster",
        "Match": { "Path": "/yarp/authorization/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/authorization" }]
      },
      "transaction-yarp": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/yarp/transaction/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/yarp/transaction" }]
