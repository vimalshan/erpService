{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CompensationDb": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DDDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Application Name=\"CompensationService\";Command Timeout=0"
  },
  "Jwt": {
    "Key": "AuthProviderSuperSecretKey_ChangeInProduction_Min32Chars!",
    "Issuer": "AuthProvider",
    "Audience": "AuthProviderClients",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Port": 5672,
    "VirtualHost": "/",
    "ExchangeName": "CompensationExchange",
    "QueueName": "CompensationQueue",
    "RoutingKey": "compensation.events"
  },
  "AzureStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net",
    "BlobContainerName": "compensation-documents"
  },
  "HealthChecks": {
    "Enabled": true,
    "IncludeDetails": true,
    "IncludeExceptionDetails": false
  },
  "Polly": {
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerTimeoutSeconds": 30,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 2
  }
}