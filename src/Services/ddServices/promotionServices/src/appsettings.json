{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DDDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Connect Timeout=30;Application Name=PromotionService"
  },
  "JwtSettings": {
    "Authority": "http://localhost:7000",
    "Audience": "promotion-service",
    "Issuer": "dddb-auth-service",
    "SecretKey": "DD_Promotion_JWT_Secret_Key_2026_@#$",
    "ExpiryMinutes": 60,
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "dddb.events",
    "Queues": {
      "PromotionApproved": "promotion.approved",
      "PromotionRejected": "promotion.rejected",
      "RatingFinalized": "rating.finalized",
      "IncrementApproved": "increment.approved"
    }
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "promotion-documents",
    "MaxFileSizeBytes": 5242880
  },
  "ApiSettings": {
    "ServiceName": "Promotion Service",
    "Version": "1.0.0"
  },
  "HealthChecks": {
    "Enabled": true
  },
  "Polly": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "AllowedHosts": "*"
}
