# ──────────────────────────────────────────────────────────────────────────────
# DD ERP Microservices — Environment Configuration
# Copy this file to .env and update values for your environment
# ──────────────────────────────────────────────────────────────────────────────

# ─── SQL Server ──────────────────────────────────────────────────────────────
DB_PASSWORD=YourStrong@Passw0rd

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-very-long-secret-key-change-this-in-production-at-least-32-characters

# ─── Docker Registry (for K8s) ──────────────────────────────────────────────
DOCKER_REGISTRY=dderp
IMAGE_TAG=latest
