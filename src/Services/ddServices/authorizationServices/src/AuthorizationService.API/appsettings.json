{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=AuthorizationServiceDb;Integrated Security=True;"
  },
  "JwtSettings": {
    "SecretKey": "your-very-long-secret-key-change-this-in-production-at-least-32-characters",
    "Issuer": "AuthorizationService",
    "Audience": "AuthorizationServiceClient",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Hostname": "localhost",
    "Username": "guest",
    "Password": "guest",
    "Port": 5672
  },
  "AzureStorage": {
    "BlobConnectionString": "DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net",
    "ContainerName": "authorization-documents"
  },
  "AllowedHosts": "*"
}
