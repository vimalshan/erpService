# ============================================================
# ERP Microservice Environment Configuration
# Copy this to .env and update values for your environment
# ============================================================

# SQL Server
SQL_SA_PASSWORD=YourStrong@Passw0rd!

# RabbitMQ
RABBITMQ_USER=erp_user
RABBITMQ_PASS=erp_password

# JWT (shared across all services)
JWT_SECRET_KEY=YourSuperSecretKeyForJWTTokenGeneration2026!@#$%^&*()

# Azure Storage (optional)
AZURE_STORAGE_CONNECTION=UseDevelopmentStorage=true
