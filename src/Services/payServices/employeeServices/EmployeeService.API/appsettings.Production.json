{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=PAYDB;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "EmployeeService",
    "Audience": "ERPMicroserviceAudience",
    "ExpiryInMinutes": 60
  },

  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASS}",
    "VirtualHost": "erp",
    "Enabled": true,
    "RetryCount": 5,
    "RetryIntervalSeconds": 10
  },

  "AzureStorage": {
    "ConnectionString": "${AZURE_STORAGE_CONNECTION}",
    "ContainerName": "employee-documents"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/employee-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
